# =============================================
# FuelUp - Environment template (names only, no secrets)
# PUBLIC (NEXT_PUBLIC_*) = client-safe. Everything else = server-only.
# See src/config/env.ts for centralized access.
# =============================================

# --- PUBLIC: Clerk (safe to expose in browser) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# --- SERVER-ONLY: never use NEXT_PUBLIC_ prefix for these ---
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
DATABASE_URL=

# --- SERVER-ONLY: AI food parsing (Phase 8, names only — never commit secrets) ---
# Provider implementation: 'openai-compatible' (OpenAI, Groq, OpenRouter, ...).
AI_PROVIDER=openai-compatible
# Base URL of the chat-completions endpoint (no trailing /chat/completions).
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Bounds and guards (defaults shown).
AI_TIMEOUT_MS=20000
AI_MAX_TEXT_CHARS=500
AI_MAX_ITEMS=15
AI_REQUESTS_PER_HOUR=20

# --- SERVER-ONLY: AI vision (Phase 9, names only — never commit secrets) ---
# Model for image tasks (defaults to AI_MODEL). Must support image input.
AI_VISION_MODEL=
# Kill-switch for photo analysis: 'false' disables even with a key present.
AI_VISION_ENABLED=true
# Separate, lower hourly allowance for image requests (cost control).
AI_IMAGE_REQUESTS_PER_HOUR=10
